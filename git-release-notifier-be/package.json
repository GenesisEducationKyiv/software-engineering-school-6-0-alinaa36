{
  "name": "git-release-notifier-be",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start:dev": "tsx watch src/app.ts",
    "start:worker:dev": "tsx watch src/workers/scanner/scanner.worker.ts",
    "build": "tsc && copyfiles -u 1 src/grpc/proto/*.proto src/docs/*.yaml dist/ && copyfiles -u 1 src/public/*.html dist/",
    "start": "node dist/app.js",
    "start:worker": "node dist/workers/scanner/scanner.worker.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node src/scripts/test-integration.js",
    "test:integration:ci": "npx --yes dotenv-cli -e .env.test --override -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "node src/scripts/test-e2e.js",
    "test:e2e:ci": "npx dotenv-cli -e .env.test -- playwright test --config playwright.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "docker:test:up": "docker-compose up -d db-test",
    "docker:test:down": "docker-compose stop db-test",
    "postinstall": "prisma generate",
    "type:check": "tsc --noEmit",
    "deps:check": "depcruise src",
    "deps:graph": "depcruise src --include-only \"^src\" --output-type mermaid --collapse \"^src/[^/]+/[^/]+\" > docs/graph/dependency-graph.md"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@grn/contracts": "*",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "amqplib": "^1.0.3",
    "dotenv": "^17.4.1",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "graphql": "^16.14.0",
    "graphql-request": "^7.4.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/amqplib": "^0.10.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.8.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^17.4.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nock": "^14.0.12",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.10"
  }
}
