  "scripts": {
    "start:dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node src/scripts/test-integration.js",
    "test:integration:ci": "dotenv-cli -e .env.test --override -- vitest run --config vitest.integration.config.ts",
    "docker:test:up": "docker-compose up -d db-test",
    "docker:test:down": "docker-compose stop db-test",
    "postinstall": "prisma generate"
  },
